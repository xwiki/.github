/*
 * The Renovate settings shared by the XWiki repositories. A repository uses them with:
 *
 *   "extends": ["github>xwiki/.github//renovate/default.json5"]
 *
 * and then adds whatever is specific to it. Beware of how Renovate merges the two: "packageRules"
 * of the preset and of the repository are concatenated, the preset's coming first, but every other
 * array is replaced wholesale by the repository's value. So a repository that needs an extra entry
 * in "ignoreDeps" has to repeat the entries below alongside its own.
 */
{
  // We want all suggestions right away
  "prHourlyLimit" : 0,
  "prConcurrentLimit" : 0,

  // Create different pull request for each major upgrade
  "separateMajorMinor": true,
  "separateMultipleMajor": true,

  // Skip Eclipse M2E special setup "dependency"
  "ignoreDeps": ["org.eclipse.m2e:lifecycle-mapping"],

  // Set a "dependencies" label on all pull requests created by Renovate
  "labels": ["dependencies"],

  "packageRules": [
    // There is no point trying to find updates for commons, rendering and platform dependencies:
    // Commons, Rendering and Platform are released together, so their versions move as one and never
    // on Renovate's watch, and an extension chooses the XWiki version it depends on on purpose, not
    // because a more recent one exists. The same goes for the old XWiki Enterprise artifacts, which
    // some platform upgrade tests and old extensions depend on in a specific version.
    {
      "matchPackagePrefixes": ["org.xwiki.commons:", "org.xwiki.rendering:", "org.xwiki.platform:", "org.xwiki.enterprise:"],
      "enabled": false
    }
  ]
}
